load("//bazel:api.bzl", "modular_py_test", "requirement")

package(default_visibility = ["//max/tests:__subpackages__"])

modular_py_test(
    name = "tests_gpu",
    srcs = ["test_prefix_cache_gpu.py"],
    exec_properties = {"test.resources:gpu-memory": "2"},
    gpu_constraints = ["//:has_gpu"] + select({
        "//:apple_gpu": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    tags = ["gpu"],
    deps = [
        "//max/python/max/driver",
        "//max/python/max/dtype",
        "//max/python/max/engine",
        "//max/python/max/experimental",
        "//max/python/max/experimental/nn",
        "//max/python/max/graph",
        "//max/python/max/nn",
        "//max/python/max/pipelines/architectures/qwen3_embedding_modulev3",
        "//max/python/max/pipelines/context",
        "//max/python/max/pipelines/kv_cache",
        "//max/python/max/pipelines/lib",
        "//max/python/max/pipelines/modeling",
        requirement("numpy"),
    ],
)
